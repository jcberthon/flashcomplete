{
  "name": "flashcomplete-workspace",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "core",
    "adapters/vscode"
  ],
  "scripts": {
    "build": "npm run build -w core && npm run build -w adapters/vscode",
    "typecheck": "npm run typecheck -w core && npm run typecheck -w adapters/vscode",
    "test": "npm run test -w core",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run build && npm run typecheck && npm run test",
    "package": "npm run package -w adapters/vscode"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.0.9": true,
    "keytar@7.9.0": true
  }
}
